# Ignore everything by default
*
!*/

# ソースコード
!src/**
!src/**/*.py
!src/**/*.ipynb
!src/**/*.json
!src/**/*.yaml
!src/**/*.yml
!src/**/*.txt
!src/**/*.sh
!src/**/*.md

# コンフィグ
!config/**
!config/**/*.json
!config/**/*.yaml
!config/**/*.yml
!config/**/*.md
!config/**/*.txt

# 使用したデータ（abstract配下のデータは残す）
!abstract/**
!abstract/**/*

# data/直下は不要
/data/**
!/data/
!/data/README*
!/data/*.md

# drawio
!*.drawio
!**/*.drawio

# マークダウン（階層問わず）
!*.md
!**/*.md

# その他必要最小限
!README*
!LICENSE*
!requirements*.txt
!pyproject.toml
!setup.py
!Pipfile
!environment.yml
!Dockerfile
!Makefile

# 除外（生成物等）
data/summary/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
.cache/
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# 開発メモ（公開しない）
/todo.md
/意思決定.md
/AIとの関わり方.md
/manualmake_usage.md
