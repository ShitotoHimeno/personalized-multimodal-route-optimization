# Ignore everything by default
*
!*/

# Allow source code
!src/**
!src/**/*.py
!src/**/*.js
!src/**/*.ts
!src/**/*.json
!src/**/*.yaml
!src/**/*.yml
!src/**/*.txt
!src/**/*.sh

# Allow config
!config/**
!config/**/*.json
!config/**/*.yaml
!config/**/*.yml
!config/**/*.md
!config/**/*.txt

# Allow data under abstract/ (if moved there)
!abstract/**
!abstract/**/*

# Do not allow data/ at root
data/

# Allow drawio files
!*.drawio
!**/*.drawio

# Allow markdown files (including abstract.md and others in hierarchy)
!*.md
!**/*.md

# Allow other specific important files if needed
!README*
!LICENSE*
!requirements*.txt
!pyproject.toml
!setup.py
!Pipfile
!environment.yml
!Dockerfile
!Makefile

# Ignore generated/cache files
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
.cache/
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
