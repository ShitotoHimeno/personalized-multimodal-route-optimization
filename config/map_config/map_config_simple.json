{
  "map_id": "map_simple_1000m",
  "random_seed": 42,
  "coordinate": {
    "type": "local_cartesian",
    "unit": "meter",
    "bounds": {
      "x": {
        "min": 0,
        "max": 1000
      },
      "y": {
        "min": 0,
        "max": 1000
      },
      "z": {
        "min": 0,
        "max": 30
      }
    }
  },
  "nodes": {
    "walk": {
      "count": 100,
      "z_default": 0
    },
    "taxi": {
      "count": 60
    },
    "bus": {
      "count": 10
    }
  },
  "edges": {
    "directed": true,
    "walk": {
      "connect_radius": 140,
      "isolation_fallback": true,
      "distance_metric": "euclidean",
      "difficulty": {
        "calc": true,
        "min": 0.0,
        "max": 1.0,
        "method": "slope_and_roughness"
      }
    },
    "dummy": {
      "connect": [
        "walk",
        "dummy"
      ],
      "co_located_only": true,
      "enter_has_cost": true,
      "exit_has_cost": false
    },
    "transit": {
      "superpose_on": "walk",
      "bus_route": "contiguous_walk_path",
      "taxi_network": "superposed_subgraph"
    }
  },
  "time_dependency": {
    "taxi": {
      "enabled": true,
      "function": "taxi_arrival_time",
      "type": "continuous",
      "description": "乗車ダミーエッジの時間 = タクシーが現在地（同座標の徒歩ノード）へ来るまでの待ち時間",
      "params": {
        "wait_time_sec": {
          "min": 0,
          "max": 600
        },
        "speed_kmh": 30
      }
    },
    "bus": {
      "enabled": true,
      "function": "bus_timetable",
      "type": "timetable",
      "description": "乗車ダミーエッジおよび運行エッジは時刻表に従い離散的な時刻ノードとして現れる",
      "params": {
        "headway_sec": 900,
        "service_start_sec": 21600,
        "service_end_sec": 79200,
        "dwell_sec": 30
      }
    }
  },
  "time": {
    "horizon_sec": 86400,
    "step_sec": 60
  },
  "pois": {
    "mapping": {
      "hospital": 0,
      "park": 1,
      "shop": 2
    }
  }
}
