                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="p2_frontlabel" parent="1" style="text;html=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#b85450;" value="パレートフロンティア（非劣解）" vertex="1">
                    <mxGeometry height="24" width="220" x="300" y="430" as="geometry"/>
                </mxCell>
                <mxCell id="p2_domlabel" parent="1" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#666666;" value="劣解（他の解に支配される）" vertex="1">
                    <mxGeometry height="24" width="230" x="430" y="130" as="geometry"/>
                </mxCell>
                <mxCell id="p2_wa" edge="1" parent="1" style="endArrow=block;html=1;dashed=1;strokeWidth=2;strokeColor=#82b366;fontSize=11;fontColor=#82b366;exitX=0.5;exitY=0.5;" value="wₑ·s 大&lt;br&gt;→ 負荷小を選好">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="400" y="370" as="sourcePoint"/>
                        <mxPoint x="205" y="235" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="p2_wb" edge="1" parent="1" style="endArrow=block;html=1;dashed=1;strokeWidth=2;strokeColor=#6c8ebf;fontSize=11;fontColor=#6c8ebf;" value="wₜ 大&lt;br&gt;→ 時間小を選好">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="400" y="370" as="sourcePoint"/>
                        <mxPoint x="595" y="550" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="p2_center" parent="1" style="text;html=1;fontSize=10;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#333333;" value="U の評価点" vertex="1">
                    <mxGeometry height="20" width="90" x="355" y="345" as="geometry"/>
                </mxCell>
                <mxCell id="p2_legend" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=12;fontColor=#b85450;" value="● パレート解（非劣解）　　○ 劣解（支配される）" vertex="1">
                    <mxGeometry height="50" width="620" x="80" y="630" as="geometry"/>
                </mxCell>
                <mxCell id="p2_r1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" value="① 目的関数値を正規化（min-max）&lt;br&gt;&lt;br&gt;　f₁′ = (f₁ − min f₁) / (max f₁ − min f₁)&lt;br&gt;　f₂′ = (f₂ − min f₂) / (max f₂ − min f₂)&lt;br&gt;&lt;br&gt;　soft制約では遅延 d = max(0, t_d − t_max)&lt;br&gt;　も 0〜1 に正規化（d′）" vertex="1">
                    <mxGeometry height="150" width="560" x="760" y="140" as="geometry"/>
                </mxCell>
                <mxCell id="p2_r2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" value="② 重みベクトルで総合評価 U&lt;br&gt;&lt;br&gt;　U(x) = wₜ·(f₁′ + λ·d′) + wₑ·s·f₂′&lt;br&gt;　（wₜ + wₑ = 1）&lt;br&gt;　・wₜ：到着重視度　・wₑ：歩行意欲&lt;br&gt;　・s：評価方向（+1=負荷回避 / −1=運動量確保）&lt;br&gt;　⇒ U が小さい順に rank を付与" vertex="1">
                    <mxGeometry height="150" width="560" x="760" y="330" as="geometry"/>
                </mxCell>
                <mxCell id="p2_r3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" value="③ 利用者ごとの推奨解&lt;br&gt;&lt;br&gt;　同じパレート解群でも重みで選ばれる解が変わる&lt;br&gt;　・時間重視（wₜ 大）→ 到着の速い解（右下）&lt;br&gt;　・負荷回避（wₑ·s 大）→ 運動負荷の小さい解（左上）&lt;br&gt;　⇒ rank 1 の解を推奨経路として提示" vertex="1">
                    <mxGeometry height="150" width="560" x="760" y="520" as="geometry"/>
                </mxCell>
                <mxCell id="p2_l1" edge="1" parent="1" source="p2_plot" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;fontSize=11;" target="p2_r1" value="パレート解群">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p2_l2" edge="1" parent="1" source="p2_r1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;" target="p2_r2" value="">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p2_l3" edge="1" parent="1" source="p2_r2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;fontSize=11;" target="p2_r3" value="rank">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>