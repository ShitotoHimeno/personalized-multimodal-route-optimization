                </mxCell>
                <mxCell id="p2_front" edge="1" parent="1" source="p2_A" style="curved=1;endArrow=none;html=1;strokeWidth=3;strokeColor=#b85450;" target="p2_E" value="">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="260" y="300"/>
                            <mxPoint x="370" y="390"/>
