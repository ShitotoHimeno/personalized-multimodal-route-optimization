                </mxCell>
                <mxCell id="p2_E" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="" vertex="1">
                    <mxGeometry height="18" width="18" x="611" y="551" as="geometry"/>
                </mxCell>
                <mxCell id="p2_x1" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;" value="" vertex="1">
                    <mxGeometry height="14" width="14" x="293" y="173" as="geometry"/>
                </mxCell>
                <mxCell id="p2_x2" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;" value="" vertex="1">
