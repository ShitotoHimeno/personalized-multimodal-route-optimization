<mxfile host="65bd71144e">
    <diagram id="wf1" name="全体ワークフロー">
        <mxGraphModel dx="2215" dy="1762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2350" pageHeight="900" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="p1_title" parent="1" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" value="交通空白解消に向けたマルチモーダル経路計画 ワークフロー" vertex="1">
                    <mxGeometry height="40" width="1100" x="40" y="15" as="geometry"/>
                </mxCell>
                <mxCell id="p1_env" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" value="環境情報&lt;br&gt;・ノード間の距離&lt;br&gt;・困難度 g_ij（勾配＋路面粗さ）&lt;br&gt;・バスの時刻表&lt;br&gt;・タクシー到着時間" vertex="1">
                    <mxGeometry height="150" width="280" x="40" y="80" as="geometry"/>
                </mxCell>
                <mxCell id="p1_person" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" value="個人情報&lt;br&gt;・歩行速度 v&lt;br&gt;・歩行能力の限界 G_max&lt;br&gt;・到着重視度 wₜ&lt;br&gt;・歩行意欲 wₑ&lt;br&gt;・評価方向 s（+1=負荷回避 / −1=運動量確保）" vertex="1">
                    <mxGeometry height="170" width="280" x="40" y="270" as="geometry"/>
                </mxCell>
                <mxCell id="p1_order" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" value="注文情報&lt;br&gt;・出発／到着ノード（OD）&lt;br&gt;・到着時間制約 t_max&lt;br&gt;　（hard / soft / none）" vertex="1">
                    <mxGeometry height="150" width="280" x="40" y="460" as="geometry"/>
                </mxCell>
                <mxCell id="p1_build" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" value="① 時間拡張ノードマップ構築&lt;br&gt;&lt;br&gt;〈徒歩ネットワーク（ベース層）〉&lt;br&gt;・乗り物ノードを同座標に重ねる&lt;br&gt;・乗り物エッジは歩行回廊と並走&lt;br&gt;・ダミーエッジで乗車待ち時間を吸収" vertex="1">
                    <mxGeometry height="200" width="300" x="400" y="250" as="geometry"/>
                </mxCell>
                <mxCell id="p1_constraint" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" value="② 制約の適用&lt;br&gt;&lt;br&gt;・歩行可能制約&lt;br&gt;　g_ij &gt; G_max のエッジを削除&lt;br&gt;&lt;br&gt;・到着時間制約&lt;br&gt;　t_d ≤ t_max（hard/soft/none）" vertex="1">
                    <mxGeometry height="200" width="300" x="760" y="250" as="geometry"/>
                </mxCell>
                <mxCell id="p1_optimize" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" value="③ 多目的最適化（パレート解導出）&lt;br&gt;&lt;br&gt;目的関数&lt;br&gt;　f₁ = 総所要時間&lt;br&gt;　f₂ = 運動負荷（距離×困難度）&lt;br&gt;分解法（乗換1回）&lt;br&gt;　前方徒歩パレート → 交通（時刻依存Dijkstra）→ 後方徒歩パレート&lt;br&gt;⇒ パレート最適解群" vertex="1">
                    <mxGeometry height="200" width="340" x="1120" y="250" as="geometry"/>
                </mxCell>
                <mxCell id="p1_scoring" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0e8088;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" value="④ 正規化＋重み付けスコアリング&lt;br&gt;&lt;br&gt;各解の f₁, f₂ を min-max 正規化&lt;br&gt;（soft制約時は遅延 d も）&lt;br&gt;U = wₜ·(f₁′ + λ·d′) + wₑ·s·f₂′&lt;br&gt;（wₜ + wₑ = 1）&lt;br&gt;U の昇順で rank を付与" vertex="1">
                    <mxGeometry height="200" width="340" x="1520" y="250" as="geometry"/>
                </mxCell>
                <mxCell id="p1_output" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe599;strokeColor=#bf9000;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontStyle=1;" value="⑤ 推奨経路の提示&lt;br&gt;&lt;br&gt;rank 1 の解を推奨&lt;br&gt;利用者ごとに最適化" vertex="1">
                    <mxGeometry height="160" width="300" x="1920" y="270" as="geometry"/>
                </mxCell>
                <mxCell id="p1_e1" edge="1" parent="1" source="p1_env" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.3;" target="p1_build" value="地図・時刻">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p1_e2" edge="1" parent="1" source="p1_person" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;fontSize=11;exitX=0.5;exitY=1;entryX=0.35;entryY=1;" target="p1_constraint" value="G_max（歩行可否）">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="180" y="560"/>
                            <mxPoint x="865" y="560"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="p1_e3" edge="1" parent="1" source="p1_order" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=1;" target="p1_constraint" value="OD・時間制約">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="760" y="535"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="p1_e4" edge="1" parent="1" source="p1_person" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;fontSize=11;exitX=0.5;exitY=0;entryX=0.5;entryY=0;strokeColor=#82b366;" target="p1_scoring" value="重み wₜ, wₑ, s">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="180" y="60"/>
                            <mxPoint x="1690" y="60"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="p1_e5" edge="1" parent="1" source="p1_build" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;" target="p1_constraint" value="">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p1_e6" edge="1" parent="1" source="p1_constraint" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;" target="p1_optimize" value="">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p1_e7" edge="1" parent="1" source="p1_optimize" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;fontSize=11;" target="p1_scoring" value="パレート解群">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p1_e8" edge="1" parent="1" source="p1_scoring" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;fontSize=11;" target="p1_output" value="rank">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="wf2" name="パレート解と重み付けの詳細">
        <mxGraphModel dx="1309" dy="1050" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="760" math="0" shadow="0">
            <root>
