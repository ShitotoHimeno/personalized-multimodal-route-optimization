<mxfile host="app.diagrams.net" agent="opencode" version="24.0.0">
  <diagram id="wf1" name="全体ワークフロー">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2350" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="p1_title" value="交通空白解消に向けたマルチモーダル経路計画 ワークフロー" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="15" width="1100" height="40" as="geometry" />
        </mxCell>

        <mxCell id="p1_env" value="環境情報&lt;br&gt;・ノード間の距離&lt;br&gt;・困難度 g_ij（勾配＋路面粗さ）&lt;br&gt;・バスの時刻表&lt;br&gt;・タクシー到着時間" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="280" height="150" as="geometry" />
        </mxCell>

        <mxCell id="p1_person" value="個人情報&lt;br&gt;・歩行速度 v&lt;br&gt;・歩行能力の限界 G_max&lt;br&gt;・到着重視度 wₜ&lt;br&gt;・歩行意欲 wₑ&lt;br&gt;・評価方向 s（+1=負荷回避 / −1=運動量確保）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="270" width="280" height="170" as="geometry" />
        </mxCell>

        <mxCell id="p1_order" value="注文情報&lt;br&gt;・出発／到着ノード（OD）&lt;br&gt;・到着時間制約 t_max&lt;br&gt;　（hard / soft / none）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="460" width="280" height="150" as="geometry" />
        </mxCell>

        <mxCell id="p1_build" value="① 時間拡張ノードマップ構築&lt;br&gt;&lt;br&gt;〈徒歩ネットワーク（ベース層）〉&lt;br&gt;・乗り物ノードを同座標に重ねる&lt;br&gt;・乗り物エッジは歩行回廊と並走&lt;br&gt;・ダミーエッジで乗車待ち時間を吸収" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="400" y="250" width="300" height="200" as="geometry" />
        </mxCell>

        <mxCell id="p1_constraint" value="② 制約の適用&lt;br&gt;&lt;br&gt;・歩行可能制約&lt;br&gt;　g_ij &gt; G_max のエッジを削除&lt;br&gt;&lt;br&gt;・到着時間制約&lt;br&gt;　t_d ≤ t_max（hard/soft/none）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="760" y="250" width="300" height="200" as="geometry" />
        </mxCell>

        <mxCell id="p1_optimize" value="③ 多目的最適化（パレート解導出）&lt;br&gt;&lt;br&gt;目的関数&lt;br&gt;　f₁ = 総所要時間&lt;br&gt;　f₂ = 運動負荷（距離×困難度）&lt;br&gt;分解法（乗換1回）&lt;br&gt;　前方徒歩パレート → 交通（時刻依存Dijkstra）→ 後方徒歩パレート&lt;br&gt;⇒ パレート最適解群" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1120" y="250" width="340" height="200" as="geometry" />
        </mxCell>

        <mxCell id="p1_scoring" value="④ 正規化＋重み付けスコアリング&lt;br&gt;&lt;br&gt;各解の f₁, f₂ を min-max 正規化&lt;br&gt;（soft制約時は遅延 d も）&lt;br&gt;U = wₜ·(f₁′ + λ·d′) + wₑ·s·f₂′&lt;br&gt;（wₜ + wₑ = 1）&lt;br&gt;U の昇順で rank を付与" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0e8088;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1520" y="250" width="340" height="200" as="geometry" />
        </mxCell>

        <mxCell id="p1_output" value="⑤ 推奨経路の提示&lt;br&gt;&lt;br&gt;rank 1 の解を推奨&lt;br&gt;利用者ごとに最適化" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe599;strokeColor=#bf9000;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1920" y="270" width="300" height="160" as="geometry" />
        </mxCell>

        <mxCell id="p1_e1" value="地図・時刻" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.3;" edge="1" parent="1" source="p1_env" target="p1_build">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="p1_e2" value="G_max（歩行可否）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;fontSize=11;exitX=0.5;exitY=1;entryX=0.35;entryY=1;" edge="1" parent="1" source="p1_person" target="p1_constraint">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="180" y="560" />
              <mxPoint x="865" y="560" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="p1_e3" value="OD・時間制約" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=1;" edge="1" parent="1" source="p1_order" target="p1_constraint">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="760" y="535" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="p1_e4" value="重み wₜ, wₑ, s" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;fontSize=11;exitX=0.5;exitY=0;entryX=0.5;entryY=0;strokeColor=#82b366;" edge="1" parent="1" source="p1_person" target="p1_scoring">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="180" y="60" />
              <mxPoint x="1690" y="60" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="p1_e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="p1_build" target="p1_constraint">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1_e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="p1_constraint" target="p1_optimize">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1_e7" value="パレート解群" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;fontSize=11;" edge="1" parent="1" source="p1_optimize" target="p1_scoring">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1_e8" value="rank" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;fontSize=11;" edge="1" parent="1" source="p1_scoring" target="p1_output">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="wf2" name="パレート解と重み付けの詳細">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="p2_title" value="パレート解の出し方と重み付けの仕組み" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="15" width="900" height="40" as="geometry" />
        </mxCell>

        <mxCell id="p2_plot" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="80" y="140" width="620" height="470" as="geometry" />
        </mxCell>

        <mxCell id="p2_ax" value="" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="110" y="590" as="sourcePoint" />
            <mxPoint x="680" y="590" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p2_ay" value="" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="110" y="590" as="sourcePoint" />
            <mxPoint x="110" y="160" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p2_xlabel" value="f₁：総所要時間 [s] →" style="text;html=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="380" y="598" width="260" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p2_ylabel" value="f₂：運動負荷（距離×困難度） →" style="text;html=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;rotation=270;" vertex="1" parent="1">
          <mxGeometry x="30" y="325" width="240" height="30" as="geometry" />
        </mxCell>

        <mxCell id="p2_A" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="161" y="211" width="18" height="18" as="geometry" />
        </mxCell>
        <mxCell id="p2_B" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="251" y="291" width="18" height="18" as="geometry" />
        </mxCell>
        <mxCell id="p2_C" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="361" y="381" width="18" height="18" as="geometry" />
        </mxCell>
        <mxCell id="p2_D" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="491" y="471" width="18" height="18" as="geometry" />
        </mxCell>
        <mxCell id="p2_E" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="611" y="551" width="18" height="18" as="geometry" />
        </mxCell>

        <mxCell id="p2_x1" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="293" y="173" width="14" height="14" as="geometry" />
        </mxCell>
        <mxCell id="p2_x2" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="423" y="273" width="14" height="14" as="geometry" />
        </mxCell>
        <mxCell id="p2_x3" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="553" y="393" width="14" height="14" as="geometry" />
        </mxCell>

        <mxCell id="p2_front" value="" style="curved=1;endArrow=none;html=1;strokeWidth=3;strokeColor=#b85450;" edge="1" parent="1" source="p2_A" target="p2_E">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="260" y="300" />
              <mxPoint x="370" y="390" />
              <mxPoint x="500" y="480" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="p2_frontlabel" value="パレートフロンティア（非劣解）" style="text;html=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="300" y="430" width="220" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p2_domlabel" value="劣解（他の解に支配される）" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="430" y="130" width="230" height="24" as="geometry" />
        </mxCell>

        <mxCell id="p2_wa" value="wₑ·s 大&lt;br&gt;→ 負荷小を選好" style="endArrow=block;html=1;dashed=1;strokeWidth=2;strokeColor=#82b366;fontSize=11;fontColor=#82b366;exitX=0.5;exitY=0.5;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="400" y="370" as="sourcePoint" />
            <mxPoint x="205" y="235" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p2_wb" value="wₜ 大&lt;br&gt;→ 時間小を選好" style="endArrow=block;html=1;dashed=1;strokeWidth=2;strokeColor=#6c8ebf;fontSize=11;fontColor=#6c8ebf;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="400" y="370" as="sourcePoint" />
            <mxPoint x="595" y="550" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p2_center" value="U の評価点" style="text;html=1;fontSize=10;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="355" y="345" width="90" height="20" as="geometry" />
        </mxCell>

        <mxCell id="p2_legend" value="● パレート解（非劣解）　　○ 劣解（支配される）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=12;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="80" y="630" width="620" height="50" as="geometry" />
        </mxCell>

        <mxCell id="p2_r1" value="① 目的関数値を正規化（min-max）&lt;br&gt;&lt;br&gt;　f₁′ = (f₁ − min f₁) / (max f₁ − min f₁)&lt;br&gt;　f₂′ = (f₂ − min f₂) / (max f₂ − min f₂)&lt;br&gt;&lt;br&gt;　soft制約では遅延 d = max(0, t_d − t_max)&lt;br&gt;　も 0〜1 に正規化（d′）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="760" y="140" width="560" height="150" as="geometry" />
        </mxCell>

        <mxCell id="p2_r2" value="② 重みベクトルで総合評価 U&lt;br&gt;&lt;br&gt;　U(x) = wₜ·(f₁′ + λ·d′) + wₑ·s·f₂′&lt;br&gt;　（wₜ + wₑ = 1）&lt;br&gt;　・wₜ：到着重視度　・wₑ：歩行意欲&lt;br&gt;　・s：評価方向（+1=負荷回避 / −1=運動量確保）&lt;br&gt;　⇒ U が小さい順に rank を付与" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="760" y="330" width="560" height="150" as="geometry" />
        </mxCell>

        <mxCell id="p2_r3" value="③ 利用者ごとの推奨解&lt;br&gt;&lt;br&gt;　同じパレート解群でも重みで選ばれる解が変わる&lt;br&gt;　・時間重視（wₜ 大）→ 到着の速い解（右下）&lt;br&gt;　・負荷回避（wₑ·s 大）→ 運動負荷の小さい解（左上）&lt;br&gt;　⇒ rank 1 の解を推奨経路として提示" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="760" y="520" width="560" height="150" as="geometry" />
        </mxCell>

        <mxCell id="p2_l1" value="パレート解群" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;fontSize=11;" edge="1" parent="1" source="p2_plot" target="p2_r1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2_l2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="p2_r1" target="p2_r2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2_l3" value="rank" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;fontSize=11;" edge="1" parent="1" source="p2_r2" target="p2_r3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
